{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfiniteCanvas",
  "version": "0.20.0",
  "identifier": "com.basketikun.infinitecanvas",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "无限画布",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#1c1917",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:23210 http://localhost:23210 ws: wss: https: http:; img-src 'self' asset: http://asset.localhost blob: data: https: http:; media-src 'self' blob: data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-src 'self' blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics",
    "shortDescription": "无限画布",
    "longDescription": "无限画布桌面客户端"
  }
}
